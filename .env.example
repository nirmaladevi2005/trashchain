# Firebase Configuration
# Paste your Firebase Web App credentials here to switch from DEMO MODE to LIVE PILOT MODE.
# If these variables are empty or missing, TrashChain runs in DEMO MODE using local mock persistence.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Server-only Vercel environment variables. Never prefix these with VITE_.
OPENAI_API_KEY=""
# Optional. Defaults to gpt-5-mini.
OPENAI_RECOVERY_PLANNER_MODEL=""

# Firebase Admin credentials used only by /api/recovery-plan to verify Firebase ID tokens.
# Set ONE of the following options in Vercel; never expose either to the browser.
# FIREBASE_ADMIN_SERVICE_ACCOUNT='{"project_id":"...","client_email":"...","private_key":"..."}'
# FIREBASE_ADMIN_PROJECT_ID=""
# FIREBASE_ADMIN_CLIENT_EMAIL=""
# FIREBASE_ADMIN_PRIVATE_KEY=""
