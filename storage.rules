rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read for evidence, hotspot, mission, and monitoring photos
      allow read: if true;
      
      // Allow upload only if authenticated, file is image, and size < 10MB
      allow write: if request.auth != null
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
