rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is an ADMIN or ORGANIZATION
    function isPrivileged() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'ORGANIZATION']
      );
    }

    // Users collection: private profile settings
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isPrivileged();
    }

    // Public Profiles collection: public read for intentional public profile data
    match /profiles/{userId}/public {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isPrivileged();
    }

    // Hotspots: public read, authenticated create, owner/admin update
    match /hotspots/{hotspotId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.reporterId == request.auth.uid || isPrivileged());
      allow delete: if isPrivileged();
    }

    // Missions: public read, authenticated create/join, organizer/admin update
    match /missions/{missionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // Allowed for joining volunteers or status updates by organizer
      allow delete: if isPrivileged() || (isAuthenticated() && resource.data.organizerId == request.auth.uid);
    }

    // Field Activities: users can create and manage their own field activities
    match /fieldActivities/{activityId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isPrivileged();
    }

    // Recovery Records: IMMUTABILITY RULE
    // Verified recovery records cannot be altered or deleted once status == 'verified'
    match /recoveryRecords/{recordId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.status != 'verified';
      allow delete: if isPrivileged() && resource.data.status != 'verified';
    }

    // Monitoring Checkpoints: public read, authenticated create/update
    match /monitoringCheckpoints/{chkId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isPrivileged();
    }
  }
}
